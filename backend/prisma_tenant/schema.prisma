// prisma_tenant/schema.prisma
// Base de datos por TENANT (database-per-tenant).
// Sin columna cliente_id: el cliente ES la base de datos (routing vía
// master.clientes.db_name → PrismaService.getTenantClient()).
//
// Decisiones de diseño:
//   - IDs: uuid nativo (@db.Uuid) + gen_random_uuid() como red de seguridad en
//     DB. El backend genera UUIDv7 antes de cada insert (lib `uuidv7`).
//   - Enums: tablas de catálogo — no enums nativos de Postgres, para permitir
//     altas sin migración de schema (tipos_ticket es editable por el admin).
//   - Soft delete universal en entidades con identidad propia: deleted_at
//     timestamptz nullable. Las tablas join puras (archivos_ticket,
//     archivos_operacion, archivos_presupuesto, archivos_equipo) NO tienen
//     soft delete: la baja es eliminación física (ON DELETE CASCADE / delete).
//   - updatedAt gestionado por Prisma (@updatedAt) en entidades con soft delete.
//   - Soft refs cross-DB: solicitante_id, asignado_id, autor_id, subido_por_id,
//     ciclo_vigente_id, aprobado_por_id, personal_asignado_id y
//     completada_por_id
//     referencian filas de la DB master (usuarios / ciclos_vigentes).
//     NO tienen FK real — una FK cross-DB es imposible en Postgres (cada
//     tenant es una base de datos física distinta). La integridad se valida
//     en la capa de aplicación (use cases), NO en la DB.
//   - Partial indexes (ciclos_cliente.activo, tickets.ciclo_id WHERE NOT NULL,
//     tickets.asignado_id WHERE NOT NULL, ubicaciones.padre_id/activo,
//     equipos_informaticos.numero_serie) se agregan como raw SQL en la
//     migración — Prisma no expresa índices/UNIQUE parciales en el schema.
//   - CHECK (tipos_ticket.codigo IN (...)), CHECK (tamano_bytes > 0),
//     CHECK (cantidad > 0), CHECK (monto_total >= 0),
//     CHECK (porcentaje_avance BETWEEN 0 AND 100) son raw SQL en migración.
//
// En Prisma 7, la URL se pasa al constructor vía adapter:
//   new PrismaClient({ adapter: new PrismaPg(pool) })
// La conexión para las migraciones del CLI vive en prisma.tenant.config.ts.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/tenant"
}

// ─── ESTADOS (catálogo FIJO — sembrado en provisioning) ───────────────────────
//
// Estados del ciclo de vida del ticket. NO editable por el admin del tenant
// (a diferencia de tipos_ticket): el flujo de transición de estados vive en
// la capa de aplicación y depende de códigos conocidos.
// Seeds: ABIERTO, PENDIENTE_APROBACION, APROBADO, RECHAZADO, EN_PROGRESO,
//        RESUELTO, CERRADO, CANCELADO.
// Referenciado por tickets.estado_id, operaciones_ticket.estado_anterior_id
// y operaciones_ticket.estado_nuevo_id.

model Estado {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String    @unique @db.VarChar(50)
  nombre    String    @db.VarChar(100)
  color     String?   @db.VarChar(20)
  orden     Int       @default(0)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tickets             Ticket[]
  operacionesAnterior OperacionTicket[] @relation("EstadoAnterior")
  operacionesNuevo    OperacionTicket[] @relation("EstadoNuevo")

  @@map("estados")
}

// ─── PRIORIDADES (catálogo FIJO — sembrado en provisioning) ──────────────────
//
// Seeds: BAJA (orden 10), MEDIA (20), ALTA (30), CRITICA (40).
// Usado por el módulo SLA para calcular sla_vence_at en tickets.
//
// sla_horas/sla_activo (antes vivían en la tabla separada `sla_config`,
// eliminada — el SLA es un atributo de la prioridad, no una entidad propia):
// horas objetivo de resolución para tickets de esta prioridad. NULL = sin
// SLA aplicable. CHECK (sla_horas IS NULL OR sla_horas > 0) en migración.
// Editable por ADMINISTRADOR (permiso `catalogo:gestionar`) desde el mismo
// form de Catálogos > Prioridades.

model Prioridad {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String    @unique @db.VarChar(50)
  nombre    String    @db.VarChar(100)
  color     String?   @db.VarChar(20)
  orden     Int       @default(0)
  activo    Boolean   @default(true)
  /// CHECK (sla_horas IS NULL OR sla_horas > 0) — enforced via migration SQL.
  slaHoras  Int?      @map("sla_horas")
  slaActivo Boolean   @default(true) @map("sla_activo")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tickets          Ticket[]
  planesPreventivo PlanPreventivo[]

  @@map("prioridades")
}

// ─── TIPOS_TICKET (catálogo EDITABLE — sembrado en provisioning) ─────────────
//
// Discriminador de flujo. Seeds base: SOPORTE, COMPRAS, EDILICIA. A diferencia
// de estados/prioridades, el administrador del tenant PUEDE agregar tipos
// propios (por eso no hay CHECK de codigo IN (...) acá — el CHECK original de
// soporte1 se retira; la app decide qué satélite (ticket_soporte /
// ticket_compra / ticket_edilicia) corresponde por convención de código, y
// tipos custom simplemente no tienen satélite).
//
// `modulo` (B2): módulo funcional dueño del tipo (SOPORTE/COMPRAS/EDILICIA/
// EQUIPOS). Separación ESTRICTA: cada tipo pertenece a exactamente un módulo.
// Es la fuente de verdad de la relación tipo↔módulo (antes se derivaba por
// convención de `codigo`, dejando a los tipos custom sin módulo → sin técnicos
// asignables). El alta de cada módulo filtra por esta columna y la elegibilidad
// de asignación la lee directo.

model TipoTicket {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String    @unique @db.VarChar(50)
  nombre    String    @db.VarChar(100)
  modulo    String    @db.VarChar(50)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tickets Ticket[]

  @@index([modulo, activo])
  @@map("tipos_ticket")
}

// ─── SECTORES (catálogo — WU-03, sdd/compras-tres-etapas-y-sectores) ────────
//
// Sector de destino de una compra (Computación, Librería, Mantenimiento
// edilicio, ...). Catálogo editable por tenant, calcado de TipoTicket.
// codigo UNIQUE sin índice parcial por deleted_at (ADR-T10): un código dado
// de baja NO se reutiliza. Sin seed: nace vacío.

model Sector {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String    @unique @db.VarChar(50)
  nombre    String    @db.VarChar(100)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  compras     Compra[]
  movimientos MovimientoInsumo[]

  @@map("sectores")
}

// ─── TIPO_OPERACION (catálogo — sembrado en provisioning) ────────────────────
//
// Tipos de evento registrables en el timeline de un ticket.
// Seeds: CAMBIO_ESTADO, COMENTARIO, ASIGNACION, ADJUNTO, AVANCE_EDILICIO.

model TipoOperacion {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String    @unique @db.VarChar(50)
  nombre    String    @db.VarChar(100)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  operaciones OperacionTicket[]

  @@map("tipo_operacion")
}

// ─── CICLOS_CLIENTE (períodos de gestión del tenant) ─────────────────────────
//
// Cada fila representa un período de gestión activo en este tenant.
// ciclo_vigente_id es soft ref → master.ciclos_vigentes.id (sin FK cross-DB).
// El índice parcial de activo (WHERE deleted_at IS NULL) se agrega en la
// migración.

model CicloCliente {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Soft ref → master.ciclos_vigentes.id. Sin FK: cross-DB imposible en Postgres.
  cicloVigenteId String    @map("ciclo_vigente_id") @db.Uuid
  nombre         String    @db.VarChar(100)
  fechaInicio    DateTime  @map("fecha_inicio") @db.Date
  fechaFin       DateTime  @map("fecha_fin") @db.Date
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  tickets Ticket[]
  compras Compra[]

  @@index([cicloVigenteId])
  @@index([activo]) // índice regular sobre activo (uso general de filtrado)
  // Único parcial WHERE activo=true AND deleted_at IS NULL — migración
  // 20260817140000_ciclo_unico_activo (WU-02, ADR-T8). Prisma no expresa
  // índices únicos parciales en el DSL: vive como raw SQL en la migración.
  @@map("ciclos_cliente")
}

// ─── TICKETS (entidad central) ────────────────────────────────────────────────
//
// Un ticket unificado con discriminador tipo_id.
// solicitante_id y asignado_id son soft refs → master.usuarios.id (sin FK).
// Partial indexes en ciclo_id (WHERE NOT NULL) y asignado_id (WHERE NOT NULL)
// se agregan como raw SQL en la migración.
// numero: correlativo por tenant, generado por la app (NO por la DB — evita
// depender de una sequence compartida entre tipos), formato:
//   {PREFIJO}-{YEAR}-{SEQ_5DIGITS}   ej. SOP-2026-00042
//   SOPORTE → SOP, COMPRAS → COM, EDILICIA → EDI (tipos custom: prefijo propio).
// ticket_referencia_id: self-FK nullable — "este ticket continúa de #X"
// (ej. una reapertura o un ticket derivado). Sin ON DELETE especial: la baja
// de un ticket es siempre soft delete, nunca DELETE físico.
// sla_vence_at / vencido: calculados por el módulo SLA a partir de
// prioridad + tipo (y, a futuro, calendario laboral). `vencido` es una
// bandera desnormalizada, recalculada por un job/use case — NO un
// GENERATED ALWAYS de Postgres, porque depender de now() en un cálculo
// generado complica los tests y el control de husos horarios.

model Ticket {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero             String    @unique @db.VarChar(20)
  titulo             String    @db.VarChar(255)
  descripcion        String?   @db.Text
  tipoId             String    @map("tipo_id") @db.Uuid
  estadoId           String    @map("estado_id") @db.Uuid
  prioridadId        String    @map("prioridad_id") @db.Uuid
  cicloId            String?   @map("ciclo_id") @db.Uuid
  /// Self-FK nullable → tickets.id. "Este ticket continúa de #X".
  ticketReferenciaId String?   @map("ticket_referencia_id") @db.Uuid
  /// Soft ref → master.usuarios.id. Sin FK cross-DB.
  solicitanteId      String    @map("solicitante_id") @db.Uuid
  /// Soft ref → master.usuarios.id. NULL = sin asignar.
  asignadoId         String?   @map("asignado_id") @db.Uuid
  /// Calculado por el módulo SLA (prioridad + tipo). NULL = sin SLA aplicable.
  slaVenceAt         DateTime? @map("sla_vence_at") @db.Timestamptz
  /// Desnormalizado — recalculado por el módulo SLA, no autocalculado en DB.
  vencido            Boolean   @default(false)
  /// Cohorte de cálculo de SLA (sdd/sla-habil WU-3): 'CORRIDO' (24/7, tickets
  /// existentes al introducir el cálculo hábil) o 'HABIL' (horas hábiles,
  /// tickets nuevos). CHECK tickets_sla_regla_check IN ('CORRIDO','HABIL').
  /// Las filas viejas quedaron en CORRIDO por el ADD COLUMN de la migración;
  /// las nuevas nacen en HABIL por ESTE @default, que Prisma resuelve del
  /// lado del cliente y manda en el INSERT — el DEFAULT de la columna no
  /// actúa en ese camino. Mover la cohorte exige tocar los dos. Ningún caso
  /// de uso la elige: ver TicketEntity.slaRegla / TicketMapper.
  slaRegla           String    @default("HABIL") @map("sla_regla") @db.VarChar(16)
  fechaCierre        DateTime? @map("fecha_cierre") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  tipo             TipoTicket    @relation(fields: [tipoId], references: [id])
  estado           Estado        @relation(fields: [estadoId], references: [id])
  prioridad        Prioridad     @relation(fields: [prioridadId], references: [id])
  ciclo            CicloCliente? @relation(fields: [cicloId], references: [id])
  ticketReferencia Ticket?       @relation("TicketContinuacion", fields: [ticketReferenciaId], references: [id])
  ticketsDerivados Ticket[]      @relation("TicketContinuacion")

  operaciones           OperacionTicket[]
  archivosTicket        ArchivoTicket[]
  ticketEdilicia        TicketEdilicia?
  ticketSoporte         TicketSoporte?
  encuestasSatisfaccion EncuestaSatisfaccion[]
  /// Back-relation opcional: NO todo ticket nace de un plan preventivo — la
  /// mayoría son altas manuales. Posible gracias al UNIQUE sobre
  /// preventivo_generacion.ticket_id (sdd/preventivo, WU-2).
  generacionPreventivo  PreventivoGeneracion?

  @@index([tipoId])
  @@index([estadoId])
  @@index([prioridadId])
  @@index([cicloId]) // partial WHERE ciclo_id IS NOT NULL — ver migration SQL
  @@index([ticketReferenciaId]) // partial WHERE ticket_referencia_id IS NOT NULL — ver migration SQL
  @@index([solicitanteId])
  @@index([asignadoId]) // partial WHERE asignado_id IS NOT NULL — ver migration SQL
  @@index([createdAt])
  @@index([vencido])
  @@map("tickets")
}

// ─── ENCUESTAS_SATISFACCION (respuestas CSAT, sdd/csat WU2) ───────────────────
//
// Respuesta de la encuesta de satisfacción (1-5 estrellas + comentario
// opcional) que el destinatario deja al cerrarse el ticket. El token opaco
// que habilita la respuesta vive en MASTER (`encuesta_tokens`, WU1) —
// `ResolverEncuestaTokenService` necesita leer `cliente_id` ANTES de abrir
// el `TenantContext` (ADR-C1, sdd/csat/design).
//
// tokenId: soft ref → master.encuesta_tokens.id. SIN FK cross-DB. El UNIQUE
// es la mitad TENANT del mecanismo de uso único (ADR-C2) — la otra mitad es
// el compare-and-swap sobre `used_at` en MASTER (WU5).
//
// Un ticket puede tener varias respuestas si se reabre y se vuelve a
// cerrar (cada cierre emite un token nuevo); el promedio de dashboard
// (ADR-C8) solo cuenta la más reciente por ticket vía DISTINCT ON, que este
// índice sirve directo.
model EncuestaSatisfaccion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  tokenId      String    @unique @map("token_id") @db.Uuid
  /// CHECK (puntaje BETWEEN 1 AND 5) — migration SQL.
  puntaje      Int       @db.SmallInt
  comentario   String?   @db.Text
  respondidaEn DateTime  @map("respondida_en") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, respondidaEn(sort: Desc)], map: "encuestas_satisfaccion_ticket_id_respondida_en_idx")
  @@map("encuestas_satisfaccion")
}

// ─── OPERACIONES_TICKET (timeline inmutable de eventos) ───────────────────────
//
// Toda acción significativa sobre un ticket (cambio de estado, comentario,
// asignación, adjunto, avance edilicio) DEBE registrarse acá dentro de la
// misma transacción que el cambio principal.
// autor_id es soft ref → master.usuarios.id (sin FK cross-DB).
// estado_anterior_id y estado_nuevo_id son FK opcionales a estados (named
// relations).
// es_interno: distingue una nota interna (visible solo para
// staff/administración) de una nota pública (visible también para el
// solicitante). Default false — por defecto una operación es pública, salvo
// que se marque explícitamente como interna al crearla.

model OperacionTicket {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId         String    @map("ticket_id") @db.Uuid
  tipoOperacionId  String    @map("tipo_operacion_id") @db.Uuid
  descripcion      String?   @db.Text
  estadoAnteriorId String?   @map("estado_anterior_id") @db.Uuid
  estadoNuevoId    String?   @map("estado_nuevo_id") @db.Uuid
  /// Soft ref → master.usuarios.id. Sin FK cross-DB.
  autorId          String    @map("autor_id") @db.Uuid
  /// true = comentario/nota interna (staff). false = visible para el solicitante.
  esInterno        Boolean   @default(false) @map("es_interno")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  ticket         Ticket        @relation(fields: [ticketId], references: [id])
  tipoOperacion  TipoOperacion @relation(fields: [tipoOperacionId], references: [id])
  estadoAnterior Estado?       @relation("EstadoAnterior", fields: [estadoAnteriorId], references: [id])
  estadoNuevo    Estado?       @relation("EstadoNuevo", fields: [estadoNuevoId], references: [id])

  archivosOperacion ArchivoOperacion[]

  @@index([ticketId])
  @@index([tipoOperacionId])
  @@index([autorId])
  @@index([esInterno])
  @@map("operaciones_ticket")
}

// ─── ARCHIVOS (metadata de adjuntos — nunca almacena el binario) ──────────────
//
// El binario vive exclusivamente en IFileStorage (S3/local) — esta tabla solo
// guarda metadata + la clave del objeto en el servicio de storage.
// storage_key es el identificador del objeto en el servicio de storage.
// CHECK (tamano_bytes > 0) se agrega como raw SQL en la migración.
// subido_por_id es soft ref → master.usuarios.id (sin FK cross-DB).

model Archivo {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey     String    @unique @map("storage_key") @db.Text
  nombreOriginal String    @map("nombre_original") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  /// CHECK (tamano_bytes > 0) — enforced via migration SQL.
  tamanoBytes    BigInt    @map("tamano_bytes")
  /// Soft ref → master.usuarios.id. Sin FK cross-DB.
  subidoPorId    String    @map("subido_por_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  archivosTicket    ArchivoTicket[]
  archivosOperacion ArchivoOperacion[]
  archivosEquipo    ArchivoEquipo[]

  @@map("archivos")
}

// ─── ARCHIVOS_TICKET (join N:M archivos ↔ tickets) ────────────────────────────
//
// Sin soft delete: la baja es eliminación física. ON DELETE CASCADE en ambos
// extremos. PK compuesta (archivo_id, ticket_id).

model ArchivoTicket {
  archivoId String   @map("archivo_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  archivo Archivo @relation(fields: [archivoId], references: [id], onDelete: Cascade)
  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([archivoId, ticketId])
  @@index([ticketId])
  @@map("archivos_ticket")
}

// ─── ARCHIVOS_OPERACION (join N:M archivos ↔ operaciones_ticket) ──────────────
//
// Sin soft delete: ON DELETE CASCADE en ambos extremos.
// PK compuesta (archivo_id, operacion_id).

model ArchivoOperacion {
  archivoId   String   @map("archivo_id") @db.Uuid
  operacionId String   @map("operacion_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  archivo   Archivo         @relation(fields: [archivoId], references: [id], onDelete: Cascade)
  operacion OperacionTicket @relation(fields: [operacionId], references: [id], onDelete: Cascade)

  @@id([archivoId, operacionId])
  @@map("archivos_operacion")
}

// ─── REPARACIONES EDILICIAS ────────────────────────────────────────────────────
//
// ticket_edilicia (satélite 1:1 con tickets), subtareas_edilicia (pasos de la
// reparación).
//
// ticket_edilicia: satélite 1:1 de tickets con tipo.codigo='EDILICIA'.
//   ubicacion: TEXTO LIBRE (VarChar 255). Antes era una FK a un catálogo
//     `ubicaciones` (árbol), removido — módulo que no se usa (migración
//     20260812160000_remover_ubicaciones, backfill del nombre a texto).
//   personal_asignado_id: soft ref → master.usuarios.id (sin FK cross-DB).
//   porcentaje_avance: NUMERIC(5,2), CHECK 0-100. Recalculado por la app.
// subtareas_edilicia: pasos de la reparación.
//   completada_por_id: soft ref → master.usuarios.id.
// comentarios_reparacion: notas del operador sobre la reparación (ej. "falta
//   el repuesto X"), a nivel de la REPARACIÓN y no de cada subtarea.
//   APPEND-ONLY: sin updated_at ni deleted_at (mismo criterio estructural que
//   operaciones_compra, ADR-C4) — un comentario no se edita ni se borra.
//   autor_id: soft ref → master.usuarios.id.
//   CHECK (char_length(btrim(texto)) BETWEEN 1 AND 2000) — migration SQL.

model TicketEdilicia {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId           String    @unique @map("ticket_id") @db.Uuid
  /// Texto libre (ex-FK a catálogo `ubicaciones`, removido — ver migración 20260812160000).
  ubicacion          String?   @db.VarChar(255)
  /// Soft ref → master.usuarios.id. NULL hasta asignación de personal específico.
  personalAsignadoId String?   @map("personal_asignado_id") @db.Uuid
  /// CHECK (porcentaje_avance >= 0 AND porcentaje_avance <= 100) — migration SQL.
  porcentajeAvance   Decimal   @default(0) @map("porcentaje_avance") @db.Decimal(5, 2)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id])

  subtareas         SubtareaEdilicia[]
  comentarios       ComentarioReparacion[]
  comprasVinculadas ReparacionCompra[]

  @@index([porcentajeAvance])
  @@map("ticket_edilicia")
}

model ComentarioReparacion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketEdiliciaId String   @map("ticket_edilicia_id") @db.Uuid
  /// CHECK (char_length(btrim(texto)) BETWEEN 1 AND 2000) — migration SQL.
  texto            String   @db.Text
  /// Soft ref → master.usuarios.id. Sin FK cross-DB.
  autorId          String   @map("autor_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticketEdilicia TicketEdilicia @relation(fields: [ticketEdiliciaId], references: [id])

  @@index([ticketEdiliciaId, createdAt], map: "comentarios_reparacion_ticket_created_at_idx")
  @@map("comentarios_reparacion")
}

// Vínculo REPARACIÓN ↔ COMPRA (`reparacion_compra`), a nivel de CABECERA de
// compra (no de ítem): el vínculo dice "esta reparación espera esta compra",
// y el grupo de estado del que se deriva el bloqueo (`derivarGrupoEstadoCompra`,
// compras/domain/services/estado-compra.ts) también es de cabecera.
//
// HARD DELETE, SIN deleted_at — se aparta a propósito de
// `comentarios_reparacion`: un vínculo equivocado es un ERROR DE DATO, no el
// dicho de una persona. Un soft delete obligaría a arrastrar `deleted_at IS
// NULL` en toda lectura y a una UNIQUE parcial, por un historial que nadie
// pidió. Si mañana hace falta, la migración es ADITIVA.
//
// SIN updated_at: el vínculo no se edita — se crea o se borra.
//
// UNIQUE(ticketEdiliciaId, compraId): vincular dos veces la misma compra a la
// misma reparación no cambia el estado derivado, pero sí duplicaría la fila
// en "qué compras la frenan". Además da idempotencia al endpoint de vincular
// (ON CONFLICT DO NOTHING) sin check-then-insert (ventana de carrera).
model ReparacionCompra {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketEdiliciaId String   @map("ticket_edilicia_id") @db.Uuid
  compraId         String   @map("compra_id") @db.Uuid
  /// Marca de INICIO del bloqueo. La métrica de tiempo bloqueado está fuera
  /// de alcance, pero el dato queda disponible sin costo adicional.
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticketEdilicia TicketEdilicia @relation(fields: [ticketEdiliciaId], references: [id])
  compra         Compra         @relation(fields: [compraId], references: [id])

  @@unique([ticketEdiliciaId, compraId], map: "reparacion_compra_ticket_compra_key")
  @@map("reparacion_compra")
}

model SubtareaEdilicia {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketEdiliciaId String    @map("ticket_edilicia_id") @db.Uuid
  descripcion      String    @db.VarChar(255)
  completada       Boolean   @default(false)
  completadaEn     DateTime? @map("completada_en") @db.Timestamptz
  /// Soft ref → master.usuarios.id. NULL mientras no esté completada.
  completadaPorId  String?   @map("completada_por_id") @db.Uuid
  orden            Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  ticketEdilicia TicketEdilicia @relation(fields: [ticketEdiliciaId], references: [id])

  @@index([ticketEdiliciaId])
  @@map("subtareas_edilicia")
}

// ─── EQUIPOS INFORMÁTICOS ──────────────────────────────────────────────────────
//
// equipos_informaticos, componentes_equipo, archivos_equipo (adjuntos),
// ticket_soporte (satélite 1:1).
//
// equipos_informaticos: inventario de equipos del tenant.
//   numero_serie: UNIQUE parcial WHERE NOT NULL — raw SQL en migración.
//   ubicacion_id: FK → ubicaciones.id (nullable).
//   NOTA: los equipos NO se asignan a personas — la asignación vive
//   únicamente en el ticket (`ticket_soporte`/`ticket.asignado_id`); la
//   columna `asignado_a_id` de esta tabla se DROPEÓ.
// componentes_equipo: hardware instalado en un equipo. FK a equipo.
//   tipo_componente_codigo: soft ref → master.tipos_componente.codigo (sin FK
//   cross-DB) — el catálogo tenant `tipos_componente` se ELIMINÓ en PR4b
//   (sdd/tipos-componente-master); el catálogo ahora es global (MASTER).
// archivos_equipo: adjuntos de equipo (sin entidad de dominio propia — solo
//   tabla + repo de infraestructura, clona el patrón de ArchivoTicket).
// ticket_soporte: satélite 1:1 con tickets de tipo SOPORTE.
//   equipo_id: NULLABLE — un ticket de soporte puede no referenciar un equipo.

model EquipoInformatico {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre             String    @db.VarChar(255)
  /// UNIQUE PARCIAL WHERE NOT NULL — enforced via CREATE UNIQUE INDEX en migration SQL.
  numeroSerie        String?   @map("numero_serie") @db.VarChar(255)
  marca              String?   @db.VarChar(100)
  modelo             String?   @db.VarChar(100)
  fechaAdquisicion   DateTime? @map("fecha_adquisicion") @db.Date
  /// Ubicación física como TEXTO LIBRE (siempre en mayúscula, normalizado en la
  /// capa de aplicación). Antes era FK a `ubicaciones` — se pasó a texto libre.
  ubicacion          String?   @db.VarChar(255)
  /// Modelo del catálogo (sdd/insumos-catalogo). NULLABLE a propósito: un clon
  /// armado en casa no tiene marca ni modelo y existe igual — simplemente no
  /// participa de la compatibilidad con insumos. Convive con los campos de texto
  /// `marca`/`modelo` de arriba, que siguen siendo la vía para un equipo sin
  /// modelo de catálogo; cuando hay `modeloEquipoId`, la pantalla muestra el del
  /// catálogo.
  /// ÍNDICE PARCIAL WHERE NOT NULL — enforced via CREATE INDEX en migration SQL.
  modeloEquipoId     String?   @map("modelo_equipo_id") @db.Uuid
  /// Valoración del equipo: importe (valor) + fecha en que se registró.
  importe            Decimal?  @db.Decimal(14, 2)
  fechaValoracion    DateTime? @map("fecha_valoracion") @db.Date
  /// Observaciones libres del técnico.
  observaciones      String?   @db.Text
  /// Valor residual (post-depreciación) + fecha del cálculo. El PORCENTAJE de
  /// depreciación NO se persiste — es solo una ayuda de cálculo en la UI que
  /// deriva `valorResidual` = importe × (1 − %/100).
  valorResidual      Decimal?  @map("valor_residual") @db.Decimal(14, 2)
  fechaValorResidual DateTime? @map("fecha_valor_residual") @db.Date
  activo             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  modeloEquipo ModeloEquipo? @relation(fields: [modeloEquipoId], references: [id])

  componentes      ComponenteEquipo[]
  archivos         ArchivoEquipo[]
  tickets          TicketSoporte[]
  planesPreventivo PlanPreventivo[]
  movimientos      MovimientoInsumo[]

  @@map("equipos_informaticos")
}

// ─── CATÁLOGO DE INSUMOS (sdd/insumos-catalogo, Entrega 1) ──────────────────
//
// Tres catálogos y una relación. La pieza central es `InsumoModeloEquipo`: la
// compatibilidad pertenece al MODELO de equipo, no a la instancia. Un tóner
// sirve a quince impresoras y una impresora usa cuatro tóners, uno por color;
// colgada de la instancia habría que recargarla equipo por equipo.
//
// `ComponenteEquipo` e `Insumo` NO se pisan: el componente es lo que está
// adentro de un equipo hoy, el insumo es lo que se compra y se consume. Un
// disco rígido es las dos cosas en momentos distintos. Desde WU-3
// (sdd/repuestos-vinculo-componente) un componente puede DECLARAR de qué
// repuesto del catálogo salió (`ComponenteEquipo.insumoId`, nullable) — el
// vínculo es solo trazabilidad y sigue sin pisar nada: vincularlo NO mueve
// stock ni convierte al componente en un insumo. Sacar un repuesto del
// depósito para instalarlo es la acción de WU-4, distinta de este vínculo.
//
// Las existencias (`MovimientoInsumo`) son la Entrega 2 y no están acá.

model ModeloEquipo {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Normalizada en mayúscula en la capa de aplicación, igual que `EquipoInformatico.ubicacion`.
  marca     String    @db.VarChar(100)
  modelo    String    @db.VarChar(150)
  activo    Boolean   @default(true)
  /// `clock_timestamp()` y no `now()` — issue #172, mismo mecanismo que
  /// `MovimientoInsumo.createdAt` (ver su comentario, más abajo, para el
  /// porqué completo). `now()` se resuelve del lado del cliente y viaja
  /// siempre en el INSERT; el mapper (`ModeloEquipoMapper.toPersistence`) lo
  /// omite a propósito para que este DEFAULT sea quien decida la fecha.
  /// Quedan ~15 agregados del catálogo con el patrón viejo, sin evidencia de
  /// que su orden temporal alimente ningún cálculo — no es esta unidad.
  createdAt DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  equipos        EquipoInformatico[]
  compatibilidad InsumoModeloEquipo[]

  /// UNIQUE (marca, modelo) SIN índice parcial por `deleted_at` — mismo criterio
  /// que `sectores`: un modelo dado de baja no se reutiliza.
  @@unique([marca, modelo])
  @@map("modelos_equipo")
}

model FamiliaInsumo {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String    @unique @db.VarChar(30)
  nombre    String    @db.VarChar(100)
  activo    Boolean   @default(true)
  /// Repuesto de equipo (mouse, teclado, CPU...) vs. consumible (tóner,
  /// cartucho...). Sembrado en `true` para el piso universal de repuestos
  /// (WU-1, sdd/repuestos-familias); el `@default(false)` es solo el piso de
  /// las filas existentes y de quien no lo marque en el ABM — Prisma resuelve
  /// este DEFAULT del lado del cliente y lo manda en el INSERT, así que el
  /// ABM siempre lo envía explícito.
  esRepuesto Boolean  @default(false) @map("es_repuesto")
  /// `clock_timestamp()` — issue #172. Ver el comentario de
  /// `ModeloEquipo.createdAt`, arriba, para el porqué completo.
  createdAt DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  insumos Insumo[]

  @@map("familias_insumo")
}

model UnidadMedida {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String    @unique @db.VarChar(20)
  nombre    String    @db.VarChar(50)
  activo    Boolean   @default(true)
  /// `clock_timestamp()` — issue #172. Ver el comentario de
  /// `ModeloEquipo.createdAt`, arriba, para el porqué completo.
  createdAt DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  insumos Insumo[]

  @@map("unidades_medida")
}

model Insumo {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo         String    @unique @db.VarChar(50)
  nombre         String    @db.VarChar(255)
  familiaId      String    @map("familia_id") @db.Uuid
  unidadMedidaId String    @map("unidad_medida_id") @db.Uuid
  /// Punto de reposición. Nullable: no todo insumo tiene uno. CHECK (>= 0).
  stockMinimo    Decimal?  @map("stock_minimo") @db.Decimal(10, 2)
  activo         Boolean   @default(true)
  /// `clock_timestamp()` — issue #172. Ver el comentario de
  /// `ModeloEquipo.createdAt`, arriba, para el porqué completo.
  createdAt      DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  familia             FamiliaInsumo             @relation(fields: [familiaId], references: [id])
  unidadMedida        UnidadMedida              @relation(fields: [unidadMedidaId], references: [id])
  codigosAlternativos InsumoCodigoAlternativo[]
  compatibilidad      InsumoModeloEquipo[]
  movimientos         MovimientoInsumo[]
  /// Ítems de compra que declaran comprar ESTE insumo (insumos-entrega-3,
  /// unidad 1). Relación inversa de `ItemCompra.insumo`; no todo ítem tiene
  /// una — los históricos son texto libre y quedan sin insumo para siempre.
  itemsCompra         ItemCompra[]
  /// Componentes de equipo que declaran venir DE este repuesto (WU-3,
  /// sdd/repuestos-vinculo-componente). Relación inversa de
  /// `ComponenteEquipo.insumo`; no todo componente tiene una — el camino de
  /// texto libre sigue siendo válido.
  componentes         ComponenteEquipo[]

  @@index([familiaId])
  @@index([unidadMedidaId])
  @@map("insumos")
}

model InsumoCodigoAlternativo {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  insumoId   String    @map("insumo_id") @db.Uuid
  codigo     String    @db.VarChar(50)
  fabricante String?   @db.VarChar(100)
  /// `clock_timestamp()` — issue #172. Se corrige junto con `Insumo`, no por
  /// simetría con el resto del catálogo, sino porque esta fila la escribe el
  /// MISMO `PrismaInsumoRepository.save()`, en la MISMA transacción anidada
  /// que la raíz del agregado. Ver el comentario de `ModeloEquipo.createdAt`,
  /// arriba, para el porqué completo del mecanismo.
  createdAt  DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  insumo Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  /// UNIQUE (codigo, fabricante) con `NULLS NOT DISTINCT` — raw SQL en la
  /// migración, Prisma no lo expresa. Sin esa cláusula Postgres trata cada NULL
  /// como distinto y dejaría cargar el mismo código genérico sin fabricante
  /// tantas veces como se quiera, que es justo el duplicado que esta tabla existe
  /// para evitar.
  @@index([insumoId])
  @@map("insumos_codigos_alternativos")
}

model InsumoModeloEquipo {
  insumoId       String   @map("insumo_id") @db.Uuid
  modeloEquipoId String   @map("modelo_equipo_id") @db.Uuid
  /// Rol del insumo para ese modelo. NULL cuando no tiene: una lámpara no es de
  /// ningún color. SIN `CHECK` de conjunto cerrado a propósito: los colores
  /// (NEGRO/CIAN/MAGENTA/AMARILLO) son el caso frecuente, no el único — un modelo
  /// puede llevar tambor, fusor o kit de mantenimiento. Es el mismo criterio por
  /// el que `familias_insumo` es tabla y no `CHECK`. Se normaliza a mayúscula en
  /// la capa de aplicación.
  rol            String?  @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  insumo       Insumo       @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  modeloEquipo ModeloEquipo @relation(fields: [modeloEquipoId], references: [id], onDelete: Cascade)

  @@id([insumoId, modeloEquipoId])
  @@index([modeloEquipoId])
  @@map("insumos_modelos_equipo")
}

// ─── MOVIMIENTOS DE INSUMO (insumos-entrega-2, unidad 1) ────────────────────
//
// Bitácora append-only de existencias, calcada de `OperacionCompra` (ADR-C4).
// El stock de un insumo es la SUMA de sus movimientos, nunca una columna
// mutable: una columna mutable admite dos verdades —el saldo y el historial— y
// el día que discrepan no hay forma de saber cuál miente.
//
// Postgres no puede expresar `SUM(cantidad) >= 0` sobre varias filas, así que
// NO hay backstop de base contra el stock negativo: la invariante depende de
// que toda escritura pase por el único punto que toma el advisory lock
// (`pg_advisory_xact_lock`, unidad 3). Un segundo repositorio, o un script que
// inserte acá directo, la rompe sin que la base lo note. Está dicho, no
// escondido.

model MovimientoInsumo {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  insumoId String @map("insumo_id") @db.Uuid
  /// CHECK (tipo IN (4 valores)) — catálogo CERRADO, ver migración. Fuente
  /// única de verdad: `TIPOS_MOVIMIENTO_INSUMO`
  /// (`src/insumos/domain/entities/tipo-movimiento-insumo.ts`), comparada
  /// contra el CHECK real por el spec de constraints.
  ///
  /// No se enumeran acá a propósito, con el mismo criterio que
  /// `OperacionCompra.tipo`: una tercera copia de la lista es una tercera cosa
  /// que se desactualiza sola. Esta ya lo hizo — decía tres valores después de
  /// que el ajuste se partiera en sus dos direcciones.
  tipo     String @db.VarChar(20)
  /// CHECK (cantidad > 0). El SIGNO lo da el `tipo`, no el número: admitir
  /// negativos daría dos formas de escribir la misma salida —SALIDA de 5 o
  /// ENTRADA de -5— y ninguna suma sabría cuál es la buena.
  cantidad Decimal @db.Decimal(10, 2)
  /// Soft ref → master.usuarios.id. Sin FK cross-DB: cada inquilino es una
  /// base física distinta — mismo criterio que `OperacionCompra.usuarioId`.
  usuarioId String  @map("usuario_id") @db.Uuid
  /// Obligatorio SOLO para el AJUSTE, y esa regla la hace cumplir el DOMINIO,
  /// no la base. Un CHECK condicional sería un segundo dueño de una regla que
  /// ya vive en la entidad, y dos dueños de la misma regla derivan; además la
  /// base no puede exigir un motivo con CONTENIDO, que es lo que interesa —
  /// un espacio en blanco la conformaría igual.
  motivo    String? @db.Text

  /// A dónde fue lo que salió. Los dos son NULLABLE y existen SOLO como
  /// trazabilidad: HAY UN SOLO STOCK, no uno por sector ni por equipo. Ninguna
  /// de las dos columnas participa de la suma — filtrar por ellas responde
  /// "qué se le puso a este equipo", nunca "cuánto hay en este sector".
  /// Las dos llevan ÍNDICE PARCIAL WHERE NOT NULL — enforced via CREATE INDEX
  /// en migration SQL.
  equipoId String? @map("equipo_id") @db.Uuid
  sectorId String? @map("sector_id") @db.Uuid

  /// De DÓNDE vino lo que entró (insumos-entrega-3, unidad 1): el ítem de
  /// compra cuya recepción originó el movimiento. Sin esta columna, "¿de qué
  /// compra vino esta entrada?" no tiene respuesta.
  ///
  /// NULLABLE: la entrada manual, la salida y el ajuste no nacen de una
  /// compra. Tampoco la origina un ítem histórico, que no tiene insumo.
  ///
  /// UNA SOLA columna hacia compras, y no también `compraId`: `items_compra`
  /// ya tiene su índice por compra y la compra se resuelve con un join. Una
  /// segunda columna sería un segundo dueño del mismo dato, y el día que
  /// discrepen no hay forma de saber cuál miente.
  ///
  /// Agregarla NO contradice el append-only de esta tabla: append-only prohíbe
  /// el UPDATE y el DELETE de filas, no el `ALTER TABLE ADD COLUMN` nullable,
  /// que no reescribe ningún hecho ya asentado.
  ///
  /// Lleva ÍNDICE PARCIAL `WHERE item_compra_id IS NOT NULL` — CREATE INDEX en
  /// la migración.
  itemCompraId String? @map("item_compra_id") @db.Uuid

  // SIN updatedAt NI deletedAt — bitácora append-only (ver comentario de
  // cabecera de esta sección). Un movimiento no se edita ni se borra: se
  // corrige con otro movimiento, que deja rastro de la corrección. NO agregar
  // por "simetría" con el resto del catálogo de insumos.
  //
  // `dbgenerated("clock_timestamp()")` — issue #159, y la función importa. Con
  // `@default(now())` Prisma resuelve la fecha del lado del CLIENTE (el
  // proceso Node) y la manda siempre dentro del INSERT, así que el
  // `DEFAULT CURRENT_TIMESTAMP` de la columna (ver
  // `20260906120000_movimientos_insumo/migration.sql`) nunca llega a
  // dispararse por el camino de la aplicación. Verificado en producción: dos
  // filas quedaron con `created_at` ~44 minutos en el futuro cuando el reloj
  // del VPS derivó, mientras que las filas sembradas por migración —que usan
  // `CURRENT_TIMESTAMP` en SQL crudo— quedaron correctas.
  //
  // POR QUÉ `clock_timestamp()` Y NO `CURRENT_TIMESTAMP`, que es lo que este
  // mismo issue puso primero: en PostgreSQL `CURRENT_TIMESTAMP` —y `now()`— son
  // la hora de INICIO DE LA TRANSACCIÓN, no la del INSERT. Quedan congeladas:
  // verificado con un `pg_sleep(1)` en el medio, las dos lecturas devuelven el
  // mismo valor al microsegundo, mientras `clock_timestamp()` avanza.
  //
  // Acá eso NO es un detalle. `insert()` corre dentro de la MISMA transacción
  // que el `pg_advisory_xact_lock` de `lockAndSumByTipo`, así que la fecha
  // quedaría fijada ANTES de que el lock se otorgue. Dos movimientos
  // simultáneos sobre el mismo insumo podrían asentarse EN ORDEN INVERSO al de
  // commit: el que arrancó antes y se quedó esperando el lock recibiría una
  // fecha anterior a la del que arrancó después, tomó el lock primero y
  // commiteó primero. Es exactamente la propiedad de orden que este cambio
  // existe para proteger — cambiar el reloj del proceso por el de inicio de
  // transacción sería seguir mintiendo, solo que distinto.
  //
  // `dbgenerated()` es la marca de Prisma para "esto lo calcula LA BASE, no
  // yo": el mapper (`MovimientoInsumoMapper.toPersistence`) omite `createdAt`
  // del INSERT a propósito, y recién ahí el `DEFAULT` de la columna se
  // dispara. Mismo mecanismo que ya usa `id` en este mismo modelo
  // (`dbgenerated("gen_random_uuid()")`), aunque ahí la app siempre pasa un
  // valor explícito y acá, después de este cambio, nunca lo pasa.
  //
  // SOLO esta tabla, no las ~30 que en este schema tienen
  // `@default(now())`: `movimientos_insumo` es la ÚNICA donde `created_at` no
  // es metadato descriptivo sino EVIDENCIA que ordena un hecho de negocio — es
  // append-only y su orden temporal decide "cuánto había en tal fecha" y a qué
  // equipo fue a parar cada repuesto (trazabilidad del #153). Un reloj de
  // proceso desviado ahí corrompe una lectura derivada, no solo un dato
  // mostrado. En el resto de las tablas `created_at` es auditoría —no
  // alimenta ninguna suma ni ningún cálculo—, así que un desvío de minutos no
  // arrastra un error de negocio; tocarlas igual multiplicaría este diff por
  // ~30 mappers para blindar un caso sin evidencia de daño. Si aparece
  // evidencia de que otra tabla SÍ deriva algo de su orden temporal, extender
  // el mismo mecanismo ahí es la próxima unidad, no esta.
  //
  // `updatedAt` (`@updatedAt`) NO se toca: es un mecanismo distinto —Prisma lo
  // resuelve también del lado del cliente, así que en teoría comparte el
  // mismo problema— pero esta tabla no tiene esa columna (ver cabecera:
  // append-only, sin `updated_at`), así que acá no hay nada que corregir.
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz

  /// `onDelete` EXPLÍCITO en las cuatro, y en las tres opcionales no es
  /// redundante: el default de Prisma para una relación OPCIONAL es
  /// `SetNull`, que contradice el `ON DELETE RESTRICT` que escribió la
  /// migración. Sin declararlo, el próximo `migrate dev` regeneraría la FK
  /// vaciando la trazabilidad en vez de frenar el borrado — justo lo que los
  /// comentarios de la migración existen para evitar.
  insumo     Insumo             @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  equipo     EquipoInformatico? @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  sector     Sector?            @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  itemCompra ItemCompra?        @relation(fields: [itemCompraId], references: [id], onDelete: Restrict)

  /// Índice compuesto que sirve a las dos consultas del módulo: el stock
  /// (`SUM(cantidad) WHERE insumo_id = ?`, cubierto por el prefijo) y la
  /// bitácora de la ficha, ordenada por fecha. Uno solo alcanza — un
  /// `@@index([insumoId])` aparte sería su prefijo, redundante y pagado en
  /// cada escritura.
  @@index([insumoId, createdAt])
  /// Índice PARCIAL `WHERE item_compra_id IS NOT NULL` — raw SQL en la
  /// migración, igual que los de `equipo_id` y `sector_id`. Sirve a "los
  /// movimientos de este ítem de compra" y evita el seq scan de la bitácora
  /// entera que el RESTRICT obliga al borrar un ítem. Parcial porque solo las
  /// entradas por recepción llevan origen: las salidas, los ajustes y las
  /// entradas manuales quedan en NULL y son la mayoría de la tabla.
  @@index([itemCompraId])
  @@map("movimientos_insumo")
}

model ComponenteEquipo {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipoId             String    @map("equipo_id") @db.Uuid
  /// Soft ref → master.tipos_componente.codigo (sin FK cross-DB). Contract
  /// (PR4b): NOT NULL — poblado por el backfill de PR4a, catálogo tenant
  /// `tipos_componente` eliminado (ver migración 20260805194710_init_tenant
  /// para el estado previo con `tipo_componente_id` FK).
  tipoComponenteCodigo String    @map("tipo_componente_codigo") @db.VarChar(50)
  /// FK real → `insumos.id` (WU-3, sdd/repuestos-vinculo-componente) —
  /// MISMA base del inquilino, a diferencia de `tipoComponenteCodigo` (que
  /// referencia MASTER, cross-DB, por eso ese es soft-ref sin FK). Nullable
  /// a propósito: el camino de texto libre sigue siendo válido, y los
  /// componentes existentes antes de este WU no tienen ni van a tener uno
  /// (sin backfill).
  ///
  /// `onDelete: Restrict`, mismo criterio que las cuatro FK de
  /// `MovimientoInsumo` hacia sus catálogos: un repuesto referenciado por un
  /// componente no se puede borrar por debajo sin que la base lo frene. Acá
  /// no aplica de todos modos —`insumos` no tiene DELETE, solo baja lógica
  /// (`activo = false`)—, pero declararlo explícito evita que un futuro
  /// `migrate dev` lo regenere en `SetNull` (default de Prisma para una
  /// relación opcional) y vacíe el vínculo en silencio.
  insumoId             String?   @map("insumo_id") @db.Uuid
  descripcion          String?   @db.VarChar(255)
  numeroSerie          String?   @map("numero_serie") @db.VarChar(255)
  capacidad            String?   @db.VarChar(100)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  equipo EquipoInformatico @relation(fields: [equipoId], references: [id])
  insumo Insumo?           @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([equipoId])
  @@index([tipoComponenteCodigo])
  @@index([insumoId])
  @@map("componentes_equipo")
}

model ArchivoEquipo {
  archivoId String   @map("archivo_id") @db.Uuid
  equipoId  String   @map("equipo_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  archivo Archivo           @relation(fields: [archivoId], references: [id], onDelete: Cascade)
  equipo  EquipoInformatico @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@id([archivoId, equipoId])
  @@index([equipoId])
  @@map("archivos_equipo")
}

model TicketSoporte {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId            String    @unique @map("ticket_id") @db.Uuid
  /// FK → equipos_informaticos.id. NULLABLE.
  equipoId            String?   @map("equipo_id") @db.Uuid
  descripcionProblema String?   @map("descripcion_problema") @db.Text
  solucionAplicada    String?   @map("solucion_aplicada") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  ticket Ticket             @relation(fields: [ticketId], references: [id])
  equipo EquipoInformatico? @relation(fields: [equipoId], references: [id])

  @@index([equipoId])
  @@map("ticket_soporte")
}

// ─── KB_ARTICULOS — RETIRADA DEL TENANT ──────────────────────────────────────
//
// La Ayuda dejó de vivir en cada cliente: pasó a ser ÚNICA y GLOBAL, en la DB
// master (`prisma_master/schema.prisma`, modelo `KbArticulo`). El mismo texto
// estaba duplicado tantas veces como tenants había y había que publicarlo
// cliente por cliente, sin que esa duplicación representara ninguna diferencia
// real: la Ayuda documenta cómo se usa el sistema, y el sistema es el mismo
// para todos.
//
// La tabla se elimina de cada tenant en la migración
// `20260819130000_drop_kb_articulos`. `tipos_ticket` pierde de paso su
// back-relation `kbArticulos`: la FK `tipo_ticket_id` no sobrevivió al cruce a
// master (un artículo global no puede apuntar al catálogo de UN cliente).

// ─── COMPRAS (reconstrucción desde cero — PR-2, sdd/redisenio-modulo-compras) ─
//
// Reemplaza el módulo legacy demolido en PR-1 (ticket_compra/items_compra/
// presupuestos/archivos_presupuesto). Ver sdd/redisenio-modulo-compras
// (spec/design) para la tabla de verdad de estados y los ADRs.
//
// Compra: raíz del agregado. numero correlativo por año (COM-{anio}-{00000}),
// generado por la app, NO por la DB (mismo patrón que tickets.numero).
// ciclo_id es FK real (misma DB tenant) — a diferencia de solicitante_id, que
// es soft ref cross-DB a master.usuarios. Cancelación atómica: cancelada_en/
// cancelado_por_id/motivo_cancelacion son todos NULL o todos NOT NULL — CHECK
// en migración.
//
// ItemCompra: vive DENTRO del agregado Compra (ADR-C2 — puerto único,
// divergencia declarada vs `equipos`: todos los invariantes de este dominio
// son cross-item, ej. estado derivado de cabecera). estado_aprobacion es
// máquina de UN paso sin retorno (PENDIENTE → APROBADO|RECHAZADO).
// decidido_por_id/decidido_en (NO aprobado_por_id/aprobado_en — ADR-C6,
// rename deliberado: el campo también se escribe en el RECHAZO, por lo que
// "aprobado_*" mentiría sobre su contenido en esa fila). cantidad_comprada/
// cantidad_entregada NUNCA retroceden (regla de aplicación) y están acotadas
// 0 <= entregada <= comprada <= cantidad (CHECK). cerrado_con_faltante es
// TERMINAL y solo es posible sobre un ítem APROBADO (CHECK).
//
// OperacionCompra: bitácora append-only del agregado. SIN updated_at NI
// deleted_at — expresión ESTRUCTURAL del append-only (ADR-C4), complementa la
// firma del puerto (`crear`/`listarPorCompra`, sin update/delete — S37).
// item_compra_id NULL = operación de cabecera (ej. CREACION, CANCELACION).
// tipo: catálogo CERRADO de 10 valores, uno por cada comando mutador del
// agregado (ADR-C4) — CHECK en migración, sin tabla de catálogo (ADR-C7:
// mismo criterio que tipo_operacion vs tipos_ticket — este set no es
// editable por el admin del tenant).
//
// Enums (estado_aprobacion, moneda, tipo de operación): VarChar + CHECK, NO
// enum nativo de Postgres ni tabla de catálogo (ADR-C7 — precedente ya
// establecido en tipos_ticket/tipo_operacion de este mismo schema).
//
// CHECKs — ver migración `20260813130000_compras_schema_checks` y su spec
// colocado `compras-checks.integration.spec.ts` (H6: un `it` por CHECK,
// probado con el INSERT raw que lo viola, no leyendo el DDL).

model Compra {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero            String    @unique @db.VarChar(20)
  fechaSolicitud    DateTime  @map("fecha_solicitud") @db.Date
  motivo            String    @db.VarChar(255)
  descripcion       String?   @db.Text
  /// Soft ref → master.usuarios.id. Sin FK cross-DB.
  solicitanteId     String    @map("solicitante_id") @db.Uuid
  cicloId           String    @map("ciclo_id") @db.Uuid
  /// CHECK cancelación atómica (los 3 campos NULL o los 3 NOT NULL) — migration SQL.
  canceladaEn       DateTime? @map("cancelada_en") @db.Timestamptz
  /// Soft ref → master.usuarios.id. Sin FK cross-DB.
  canceladoPorId    String?   @map("cancelado_por_id") @db.Uuid
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text
  /// Sector de destino (WU-03). Nullable, sin backfill (S67) — uno por compra, en cabecera.
  sectorId          String?   @map("sector_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  ciclo  CicloCliente @relation(fields: [cicloId], references: [id])
  sector Sector?      @relation(fields: [sectorId], references: [id])

  items                  ItemCompra[]
  operaciones            OperacionCompra[]
  reparacionesVinculadas ReparacionCompra[]

  @@index([cicloId])
  @@index([solicitanteId])
  @@index([createdAt])
  @@index([canceladaEn]) // partial WHERE cancelada_en IS NOT NULL — ver migration SQL
  @@index([sectorId]) // partial WHERE sector_id IS NOT NULL — ver migration SQL
  @@map("compras")
}

model ItemCompra {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compraId             String    @map("compra_id") @db.Uuid
  descripcion          String    @db.VarChar(255)
  /// De qué insumo del catálogo se trata (insumos-entrega-3, unidad 1). Es lo
  /// que permite que recibir la compra sume el stock solo: sin esta columna,
  /// `descripcion` es texto libre y no hay a qué insumo imputarle la entrada.
  ///
  /// NULLABLE y SIN backfill, para siempre. Los ítems anteriores a esta
  /// migración son texto libre y no hay forma confiable de mapearlos al
  /// catálogo; backfillear uno con `cantidadRecibida > 0` abriría además la
  /// pregunta de fabricar movimientos retroactivos con fecha falsa. El NULL
  /// significa "sin insumo" y la recepción de ese ítem funciona como antes.
  insumoId             String?   @map("insumo_id") @db.Uuid
  /// CHECK (cantidad > 0) — migration SQL.
  cantidad             Decimal   @db.Decimal(10, 2)
  proveedor            String    @db.VarChar(255)
  /// CHECK (monto >= 0) — migration SQL.
  monto                Decimal   @db.Decimal(14, 2)
  /// CHECK (moneda IN ('ARS','USD','EUR')) — migration SQL.
  moneda               String    @default("ARS") @db.VarChar(10)
  fechaCotizacion      DateTime  @map("fecha_cotizacion") @db.Date
  observaciones        String?   @db.Text
  /// CHECK (estado_aprobacion IN ('PENDIENTE','APROBADO','RECHAZADO')) — migration SQL.
  estadoAprobacion     String    @default("PENDIENTE") @map("estado_aprobacion") @db.VarChar(20)
  /// Soft ref → master.usuarios.id. NULL mientras PENDIENTE — CHECK decisión atómica.
  decididoPorId        String?   @map("decidido_por_id") @db.Uuid
  decididoEn           DateTime? @map("decidido_en") @db.Timestamptz
  /// Las tres etapas de ejecución (compras-tres-etapas-y-sectores, M2, ADR-T1).
  /// Encadenadas: cantidad_entregada <= cantidad_recibida <= cantidad_ordenada <= cantidad.
  /// NUNCA retroceden (regla de aplicación). CHECK (0 <= cantidad_ordenada <= cantidad).
  cantidadOrdenada     Decimal   @default(0) @map("cantidad_ordenada") @db.Decimal(10, 2)
  /// Antes "cantidad_comprada" — renombrada por M2 (RENAME COLUMN, punto de no retorno del deploy).
  /// CHECK (0 <= cantidad_recibida <= cantidad_ordenada).
  cantidadRecibida     Decimal   @default(0) @map("cantidad_recibida") @db.Decimal(10, 2)
  /// CHECK (0 <= cantidad_entregada <= cantidad_recibida).
  cantidadEntregada    Decimal   @default(0) @map("cantidad_entregada") @db.Decimal(10, 2)
  /// Fecha de cada etapa (compras-tres-etapas-y-sectores R4/R5). Nullable, prellenada con
  /// hoy (Argentina) si no se provee. CHECK de orden cronológico + rechazo de futuro en dominio.
  fechaOrden           DateTime? @map("fecha_orden") @db.Date
  fechaRecepcion       DateTime? @map("fecha_recepcion") @db.Date
  fechaEntrega         DateTime? @map("fecha_entrega") @db.Date
  /// TERMINAL. Solo posible sobre ítem APROBADO — CHECK.
  cerradoConFaltante   Boolean   @default(false) @map("cerrado_con_faltante")
  motivoCierreFaltante String?   @map("motivo_cierre_faltante") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  compra Compra @relation(fields: [compraId], references: [id])
  /// `onDelete` EXPLÍCITO y NO redundante: el default de Prisma para una
  /// relación OPCIONAL es `SetNull`, que contradice el `ON DELETE RESTRICT`
  /// que escribió la migración. Sin declararlo, el próximo `migrate dev`
  /// regeneraría la FK vaciando el vínculo en silencio, y el ítem perdería la
  /// única explicación del stock que ya emitió. Mismo criterio que las
  /// relaciones opcionales de `MovimientoInsumo`.
  insumo Insumo? @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  operaciones OperacionCompra[]
  /// Movimientos de stock originados por la recepción de este ítem. Relación
  /// inversa de `MovimientoInsumo.itemCompra`.
  movimientos MovimientoInsumo[]

  @@index([compraId])
  @@index([compraId, estadoAprobacion])
  /// Índice PARCIAL `WHERE insumo_id IS NOT NULL` — raw SQL en la migración,
  /// Prisma no expresa índices parciales en el DSL. Sirve a "qué ítems de
  /// compra tienen este insumo" y evita el seq scan que el RESTRICT obliga al
  /// borrar un insumo. Parcial porque los ítems históricos quedan en NULL para
  /// siempre y ninguna consulta los busca por esta columna.
  @@index([insumoId])
  @@map("items_compra")
}

model OperacionCompra {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compraId     String  @map("compra_id") @db.Uuid
  /// NULL = operación de cabecera (ej. CREACION, CANCELACION).
  itemCompraId String? @map("item_compra_id") @db.Uuid
  /// CHECK (tipo IN (10 valores)) — catálogo CERRADO, ver migration SQL.
  tipo         String  @db.VarChar(40)
  /// Soft ref → master.usuarios.id. Sin FK cross-DB.
  usuarioId    String  @map("usuario_id") @db.Uuid
  detalle      String  @db.Text
  datos        Json?

  // SIN updatedAt NI deletedAt — bitácora append-only (ver comentario de
  // cabecera de esta sección). NO agregar por "simetría" con las otras
  // entidades: es una decisión deliberada del design (ADR-C4).
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  compra     Compra      @relation(fields: [compraId], references: [id])
  itemCompra ItemCompra? @relation(fields: [itemCompraId], references: [id])

  @@index([compraId, createdAt])
  @@index([itemCompraId])
  @@map("operaciones_compra")
}

// ─── PREVENTIVO (sdd/preventivo, WU-2) ─────────────────────────────────────
//
// PlanPreventivo: cadencia declarada una vez, objetivo excluyente (equipo XOR
// ubicación), responsable que oficia de solicitante del ticket MANTENIMIENTO
// generado. La AUTORIDAD del objetivo excluyente es el dominio
// (`PlanPreventivoEntity.create()`); el CHECK de abajo es backstop (ADR-PV1,
// mismo criterio que el CSAT).
//
// intervalo_valor/intervalo_unidad + fecha_inicio: la cadencia se expresa
// como un desplazamiento fijo desde un ancla INMUTABLE. proxima_ejecucion_en
// es el puntero que el barrido consulta y avanza — SIEMPRE derivado de
// fecha_inicio + k×cadencia, NUNCA de now() ni encadenado desde el ciclo
// anterior (ADR-PV2: encadenar acumula deriva y rompe el fin de mes).
//
// responsable_id: soft ref → master.usuarios.id. Sin FK cross-DB (cada
// tenant es una base física distinta) — igual criterio que solicitante_id de
// Ticket.
//
// activo=false (o soft delete) frena la generación de ciclos futuros sin
// borrar lo ya generado (tickets y filas de preventivo_generacion quedan
// intactos).
model PlanPreventivo {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo             String    @db.VarChar(255)
  instrucciones      String?   @db.Text
  /// FK real. Excluyente con `ubicacion` — CHECK planes_preventivo_objetivo_check (ADR-PV1).
  equipoId           String?   @map("equipo_id") @db.Uuid
  /// Texto libre normalizado a MAYÚSCULA en la capa de aplicación — mismo
  /// criterio que equipos_informaticos.ubicacion. Excluyente con `equipoId`.
  ubicacion          String?   @db.VarChar(255)
  prioridadId        String    @map("prioridad_id") @db.Uuid
  /// Soft ref → master.usuarios.id. Solicitante/autor del ticket que genera el barrido.
  responsableId      String    @map("responsable_id") @db.Uuid
  /// CHECK (intervalo_valor > 0).
  intervaloValor     Int       @map("intervalo_valor")
  /// CHECK (intervalo_unidad IN ('DIAS','MESES')).
  intervaloUnidad    String    @map("intervalo_unidad") @db.VarChar(10)
  /// Ancla INMUTABLE del cálculo de ciclos. Nunca se recalcula a partir de now().
  fechaInicio        DateTime  @map("fecha_inicio") @db.Date
  /// Puntero que el barrido consulta (índice parcial) y avanza tras cada ciclo procesado.
  proximaEjecucionEn DateTime  @map("proxima_ejecucion_en") @db.Date
  activo             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  equipo       EquipoInformatico?     @relation(fields: [equipoId], references: [id])
  prioridad    Prioridad              @relation(fields: [prioridadId], references: [id])
  generaciones PreventivoGeneracion[]

  /// Parcial WHERE activo AND deleted_at IS NULL — exactamente la query del cron (ADR-PV2/PV3).
  @@index([proximaEjecucionEn], map: "planes_preventivo_proxima_ejecucion_idx")
  /// Parcial WHERE equipo_id IS NOT NULL — planes de un equipo (ficha + baja del equipo).
  @@index([equipoId], map: "planes_preventivo_equipo_id_idx")
  @@map("planes_preventivo")
}

// PreventivoGeneracion: fila de auditoría de UN ciclo de UN plan. HARD
// DELETE, sin updated_at ni deleted_at — es un HECHO registrado (qué pasó
// con este ciclo), no una opinión editable (mismo criterio que
// reparacion_compra).
//
// `resultado` es un catálogo cerrado de 4 códigos. 'RESERVADO' es
// TRANSITORIO: existe solo mientras la transacción del ciclo está en vuelo
// (ADR-PV2) — nunca debe verse committeado; el INSERT ON CONFLICT DO NOTHING
// que la crea es la primera sentencia de la transacción, cerrando la ventana
// de carrera de dos corridas concurrentes del mismo ciclo.
//
// UNIQUE(plan_id, fecha_programada) es la clave de idempotencia real
// (ADR-PV2) — el backstop de UNIQUE(ticket_id) evita que un mismo ticket
// quede referenciado por dos filas.
model PreventivoGeneracion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  /// Derivada SIEMPRE de fecha_inicio + k×cadencia del plan. Nunca de now().
  fechaProgramada DateTime @map("fecha_programada") @db.Date
  /// CHECK preventivo_generacion_resultado_check IN ('RESERVADO','GENERADO','SALTEADO_PENDIENTE','SALTEADO_ATRASO').
  resultado       String   @db.VarChar(24)
  /// NOT NULL ⟺ resultado='GENERADO' — CHECK preventivo_generacion_ticket_coherencia_check.
  ticketId        String?  @unique @map("ticket_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  plan   PlanPreventivo @relation(fields: [planId], references: [id])
  ticket Ticket?        @relation(fields: [ticketId], references: [id])

  /// UNIQUE — clave de idempotencia (ADR-PV2). Su prefijo izquierdo (plan_id)
  /// cubre el listado de generaciones por plan: NO se agrega índice suelto.
  @@unique([planId, fechaProgramada], map: "preventivo_generacion_plan_fecha_key")
  @@map("preventivo_generacion")
}

// ─── FERIADOS_CLIENTE (feriados propios del tenant, WU3 sdd/feriados-configurables) ─
//
// Excepción por cliente al calendario global de feriados (D1). Sin
// `clienteId`: el tenant ES la base de datos (mismo criterio que el resto
// del schema), y hard delete — a diferencia de las entidades con identidad
// de negocio propia, un feriado dado de baja no necesita dejar rastro; una
// fecha soft-deleted seguiría ocupando el `@unique` de `fecha`.
//
// TRAMPA DE `@db.Date`: Prisma devuelve esta columna como MEDIANOCHE UTC del
// día calendario. Aplicarle `desplazarAArgentina` (shared/domain/zona-horaria-argentina.ts)
// CORRE EL DÍA PARA ATRÁS (cae 21:00 del día anterior). El mapper que lea
// esta columna DEBE leer los componentes UTC crudos
// (`getUTCFullYear/getUTCMonth/getUTCDate`) — nunca aplicar el offset
// argentino acá. Ver `prisma_master/schema.prisma:492-498` (mismo criterio
// para el feriado global) y el hallazgo #2542 de sdd/sla-habil.
//
// El `@unique` en `fecha` ya sirve de índice de rango — sin índice adicional.

model FeriadoCliente {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// @db.Date: Prisma la devuelve como medianoche UTC — ver nota arriba. NO
  /// aplicar `desplazarAArgentina` a este campo.
  fecha       DateTime @unique @db.Date
  descripcion String   @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("feriados_cliente")
}

// ─── CALENDARIO_LABORAL_DIAS_CLIENTE (horario semanal por cliente, WU-1 sdd/horario-laboral-por-cliente) ─
//
// Mismo shape y mismos CHECK que `CalendarioLaboralDia` de MASTER
// (`prisma_master/schema.prisma:477-485`), ahora por tenant: el horario que
// usa el SLA HABIL deja de ser global. PK en `dia_semana` (0=domingo..6=sábado,
// una fila por día, sin duplicados posibles). `aperturaMinuto`/`cierreMinuto`
// NULL en ambos = día cerrado; NOT NULL en ambos con apertura < cierre = día
// abierto — el CHECK de ventana rechaza cualquier otra combinación (ver la
// migración `20260928150000_calendario_laboral_dias_cliente`). Sembrada con
// el default 9-18 lunes a viernes en la misma migración (D1).
//
// `updatedAt` NO tiene `@default` (`@updatedAt` solo actualiza en UPDATE de
// Prisma): el INSERT raw del seed setea el valor explícito.

model CalendarioLaboralDiaCliente {
  diaSemana      Int      @id @map("dia_semana") @db.SmallInt
  aperturaMinuto Int?     @map("apertura_minuto") @db.SmallInt
  cierreMinuto   Int?     @map("cierre_minuto") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("calendario_laboral_dias_cliente")
}
