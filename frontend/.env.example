# Copiar a .env.local y completar. NO commitear con valores reales.

# URL del backend NestJS (usada por route handlers y middleware, server-side).
BACKEND_URL="http://localhost:3000/api"

# Debe coincidir con JWT_SECRET del backend (verificacion de JWT en el
# middleware Edge via `jose`, sin llamar al backend en cada request).
JWT_SECRET="cambiar-por-un-secreto-fuerte"
