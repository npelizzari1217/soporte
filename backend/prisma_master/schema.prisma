// prisma_master/schema.prisma
// Base de datos MASTER: clientes, usuarios, RBAC, ciclos_vigentes.
// PR-03: DDL completo (reemplaza el placeholder MasterSeedVersion de PR-02).
//
// Decisiones de diseño (ver openspec/changes/modelo-datos-tres-flujos/design.md):
//   - IDs: uuid nativo (@db.Uuid) + gen_random_uuid() como red de seguridad en DB.
//     El backend genera UUIDv7 antes de cada insert (lib uuidv7).
//     NOTA: gen_random_uuid() produce UUIDv4 como red de seguridad en DB; UUIDv7 es
//     generado por la app (BaseEntity / uuidv7 lib) y es el flujo normal de insert.
//   - Enums: tablas de catálogo (roles, permisos) — no enums nativos de Postgres.
//   - Soft delete universal: deleted_at timestamptz nullable.
//   - updatedAt gestionado por Prisma (@updatedAt).
//   - Partial unique index en clientes.cuit y partial index en usuarios.activo
//     se agregan como raw SQL en la migración (Prisma no los expresa en @@unique/@unique).
//   - CHECK (fecha_fin > fecha_inicio) en ciclos_vigentes: raw SQL en migración.
//
// Nota: En Prisma 7, la URL se pasa al constructor via adapter:
//   new PrismaClient({ adapter: new PrismaPg(pool) })

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/master"
}

// ─── CLIENTES (catálogo de tenants) ───────────────────────────────────────────
//
// Cada fila = una organización con su propia DB Postgres operativa (db_name).
// db_name es el discriminador de routing: el TenantGuard lo usa para obtener el
// PrismaClient del tenant. La DB del cliente NUNCA contiene esta tabla.
//
// Partial UNIQUE en cuit (WHERE cuit IS NOT NULL) se agrega en la migración.

model Cliente {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String    @db.VarChar(255)
  razonSocial String?   @map("razon_social") @db.VarChar(255)
  /// Unicidad parcial: enforced SOLO via partial unique index en la migración SQL (WHERE cuit IS NOT NULL).
  /// Prisma no conoce este index, por lo que usar findFirst (NO findUnique) para lookups por cuit.
  cuit        String?   @db.VarChar(13)
  dbName      String    @unique @map("db_name") @db.VarChar(100)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  usuarios Usuario[]

  @@index([activo])
  @@map("clientes")
}

// ─── CICLOS VIGENTES (catálogo global de ciclos de gestión) ───────────────────
//
// Ciclos como "Ejercicio 2026". Los tenants los referencian via soft ref desde
// tenant.ciclos_cliente.ciclo_vigente_id (cross-DB, sin FK de nivel DB).
// Validación de no-solapamiento: en CicloVigenteUseCase, NO en trigger de DB.
// CHECK (fecha_fin > fecha_inicio) se agrega como raw SQL en la migración.

model CicloVigente {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String    @db.VarChar(100)
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime  @map("fecha_fin") @db.Date
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@index([activo])
  @@index([fechaInicio, fechaFin])
  @@map("ciclos_vigentes")
}

// ─── USUARIOS ─────────────────────────────────────────────────────────────────
//
// Identidad global de todos los usuarios (cross-tenant). Siempre se valida contra
// esta tabla en el login. El JWT incluye cliente_id → routing al tenant DB.
// Las soft refs desde tablas tenant (asignado_id, solicitante_id) apuntan a este id
// SIN FK de nivel DB (cross-DB). La integridad se valida en los use cases.
// Partial index en activo WHERE deleted_at IS NULL: raw SQL en migración.

model Usuario {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  nombre       String    @db.VarChar(100)
  apellido     String    @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.Text
  clienteId    String    @map("cliente_id") @db.Uuid
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  refreshTokens RefreshToken[]
  usuariosRoles UsuariosRoles[]

  @@index([clienteId])
  @@index([activo]) // el índice real en DB es parcial: WHERE deleted_at IS NULL — ver migration SQL
  @@map("usuarios")
}

// ─── REFRESH TOKENS ───────────────────────────────────────────────────────────
//
// Almacena el SHA-256 del refresh token crudo (nunca el valor en claro).
// Lookup por token_hash: O(1) via UNIQUE index.
// Revocación masiva por usuario_id: cubierta por el index en usuario_id.

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ─── ROLES (catálogo de roles del sistema) ────────────────────────────────────
//
// Seeds iniciales (PR-07): ADMIN, SOPORTE_IT, MANTENIMIENTO, APROBADOR_COMPRAS, SOLICITANTE.
// codigo es el identificador funcional (snake_case en mayúsculas).

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String    @unique @db.VarChar(50)
  nombre      String    @db.VarChar(100)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  rolesPermisos RolesPermisos[]
  usuariosRoles UsuariosRoles[]

  @@map("roles")
}

// ─── PERMISOS (catálogo de permisos atómicos) ─────────────────────────────────
//
// Convención: recurso:accion en minúsculas (ej. ticket:crear, compra:aprobar).
// Seeds iniciales (PR-07): 11 permisos del spec.
// El permiso efectivo de un usuario = unión de permisos de todos sus roles.
// Resolución en login → embebida en JWT → guards no consultan DB en cada request.

model Permiso {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String    @unique @db.VarChar(100)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  rolesPermisos RolesPermisos[]

  @@map("permisos")
}

// ─── ROLES_PERMISOS (N:M join) ────────────────────────────────────────────────
//
// Define qué permisos otorga cada rol.
// Sin soft delete: la baja es eliminación física de la fila de asociación.
// PK compuesta (rol_id, permiso_id) garantiza unicidad del par.

model RolesPermisos {
  rolId     String   @map("rol_id") @db.Uuid
  permisoId String   @map("permiso_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  rol     Role    @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@index([permisoId])
  @@map("roles_permisos")
}

// ─── USUARIOS_ROLES (N:M join) ────────────────────────────────────────────────
//
// Un usuario puede tener múltiples roles simultáneamente.
// Sin soft delete: la baja es eliminación física.
// PK compuesta (usuario_id, rol_id) garantiza unicidad del par.

model UsuariosRoles {
  usuarioId String   @map("usuario_id") @db.Uuid
  rolId     String   @map("rol_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Role    @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
  @@index([rolId])
  @@map("usuarios_roles")
}
