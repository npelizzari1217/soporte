# Copiar a .env y completar. NO commitear .env con valores reales.

# -- Base de datos --------------------------------------------------------
# URL MASTER: apunta a la DB de clientes/usuarios/membresias/RBAC/ciclos.
# Las DBs por-tenant se derivan de esta URL en runtime
# (PrismaService.buildTenantUrl reemplaza el nombre de la DB por el db_name
# del cliente). Requerida tambien por prisma.config.ts (migrate/generate).
DATABASE_URL_MASTER="postgresql://usuario:password@localhost:5432/soporte_master?schema=public"

# URL de UNA DB tenant (dev/test). Usada solo por prisma.tenant.config.ts
# para correr migraciones de prisma_tenant/ contra una base concreta.
DATABASE_URL_TENANT="postgresql://usuario:password@localhost:5432/soporte_tenant_test?schema=public"

# -- Auth -------------------------------------------------------------------
# Secreto de firma de los JWT (access + refresh). Generar uno fuerte, distinto
# por ambiente (ej. openssl rand -base64 48).
JWT_SECRET="cambiar-por-un-secreto-fuerte"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -- SMTP (notificaciones por email) -----------------------------------------
SMTP_HOST="smtp.tuservidor.com"
SMTP_PORT="587"
SMTP_USER="usuario@tuservidor.com"
SMTP_PASSWORD="cambiar"
SMTP_FROM="Soporte <no-reply@tuempresa.com>"
SMTP_SECURE="false"

# -- SLA (modulo sla, Fase 4) ------------------------------------------------
# Expresion cron del barrido periodico de vencimiento de SLA (SlaSweepScheduler).
# Default si no esta seteada: cada 5 min (CronExpression.EVERY_5_MINUTES).
SLA_SWEEP_CRON="*/5 * * * *"

# URL base publica de la app, usada para armar links en emails de notificacion
# (ej. ${APP_BASE_URL}/tickets/:id). Usada por notificaciones/ (PR-N, plantillas email).
APP_BASE_URL="http://localhost:3000"

# -- Bootstrap del primer usuario ROOT (super-admin cross-tenant) -----------
# Sembrado por `pnpm run seed:root` (idempotente). is_global_admin=true.
# Distinto del rol ADMINISTRADOR (vive en una membresia, scoped a un
# cliente) - ver comentario en prisma_master/schema.prisma.
ROOT_ADMIN_EMAIL="root@tuempresa.com"
ROOT_ADMIN_PASSWORD="cambiar-por-un-password-fuerte"
ROOT_ADMIN_NOMBRE="Root"
ROOT_ADMIN_APELLIDO="Admin"

# -- App ----------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
