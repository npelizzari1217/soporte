# Copiar a .env y completar. La URL MASTER apunta a la DB de tenants/usuarios/RBAC.
# Las DBs por-tenant se derivan de esta URL en runtime (PrismaService.buildTenantUrl).
DATABASE_URL_MASTER="postgresql://soporte:soporte@localhost:5432/soporte_master?schema=public"

# root-tenant-admin (Dz3) - bootstrap idempotente del primer usuario root.
# Ejecutar post migrate:master: pnpm run seed:root
ROOT_ADMIN_EMAIL="root@tuempresa.com"
ROOT_ADMIN_PASSWORD="cambiar-por-un-password-fuerte"
ROOT_ADMIN_NOMBRE="Root"
ROOT_ADMIN_APELLIDO="Admin"
ROOT_ADMIN_CLIENTE_ID="uuid-del-cliente-tenant-de-origen"
