{
  "name": "soporte-backend",
  "version": "0.1.0",
  "description": "SaaS multi-tenant de tickets — Backend NestJS",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "postinstall": "pnpm run generate:master && pnpm run generate:tenant",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fitness": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{ts,js,mjs}\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "generate:master": "prisma generate --schema=prisma_master/schema.prisma",
    "generate:tenant": "prisma generate --schema=prisma_tenant/schema.prisma",
    "validate:master": "prisma validate --schema=prisma_master/schema.prisma",
    "validate:tenant": "prisma validate --schema=prisma_tenant/schema.prisma",
    "migrate:master": "prisma migrate deploy --schema=prisma_master/schema.prisma",
    "migrate:tenant": "prisma migrate deploy --schema=prisma_tenant/schema.prisma --config prisma.tenant.config.ts",
    "migrate:tenants": "node scripts/migrate-tenants.js",
    "sync:ayuda": "node scripts/sync-ayuda.js",
    "entorno:verificar": "node scripts/regenerar-entorno.mjs verificar",
    "entorno:regenerar": "node scripts/regenerar-entorno.mjs regenerar",
    "seed:root": "ts-node prisma_master/seeds/root-bootstrap.seed.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register prisma_master/seeds/demo-seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@swc/core": "^1.15.43",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  }
}
